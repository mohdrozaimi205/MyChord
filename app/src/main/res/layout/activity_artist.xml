<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mcBg"
    android:orientation="vertical">

    <!-- Header — poster artis besar -->
    <FrameLayout
        android:id="@+id/artistHeader"
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <ImageView
            android:id="@+id/artistPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Gradient overlay bawah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_artist_gradient" />

        <!-- Butang tutup -->
        <ImageButton
            android:id="@+id/artistClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <!-- Nama artis overlay di bawah poster -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/artistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8" />

            <TextView
                android:id="@+id/artistSongCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Play All + Shuffle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/artistPlayAll"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/play_all"
            android:textColor="?attr/mcOnAccent"
            app:backgroundTint="?attr/mcAccent"
            app:icon="@drawable/ic_play"
            app:iconTint="?attr/mcOnAccent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/artistShuffle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/shuffle"
            android:textColor="?attr/mcText"
            app:backgroundTint="?attr/mcSurface2"
            app:icon="@drawable/ic_shuffle"
            app:iconTint="?attr/mcText" />
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/artistProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:indeterminateTint="?attr/mcAccent" />

    <!-- Senarai lagu -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/artistRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/mini"
        layout="@layout/view_mini_player"
        android:visibility="gone" />

    <Space android:layout_width="match_parent" android:layout_height="8dp" />
</LinearLayout>
