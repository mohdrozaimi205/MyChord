<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mcBg"
    android:orientation="vertical">

    <include android:id="@+id/top" layout="@layout/view_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDolby"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/eq_dolby"
                    android:textColor="?attr/mcOnAccent"
                    app:backgroundTint="?attr/mcAccent" />

                <TextView
                    style="@style/Txt.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/eq_dolby_note"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/qaTitle"
                style="@style/Txt.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/qa_title"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/qaBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/qaNote"
                style="@style/Txt.Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qa_old_android"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/eqSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/eq_enable"
                android:textColor="?attr/mcText"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eqUnsupported"
                style="@style/Txt.Dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eq_unsupported"
                android:visibility="gone" />

            <TextView style="@style/Txt.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/eq_presets" />

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/eqBands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView style="@style/Txt.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/eq_bass" android:textStyle="bold" />
            <com.google.android.material.slider.Slider android:id="@+id/sBass" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="1000" app:labelBehavior="gone" />

            <TextView style="@style/Txt.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/eq_virt" android:textStyle="bold" />
            <com.google.android.material.slider.Slider android:id="@+id/sVirt" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="1000" app:labelBehavior="gone" />

            <TextView style="@style/Txt.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/eq_loud" android:textStyle="bold" />
            <com.google.android.material.slider.Slider android:id="@+id/sLoud" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="1500" app:labelBehavior="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
