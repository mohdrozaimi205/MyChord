<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ═══ TubeAwak / YourTube — YouTube Music dark theme ═══ -->
    <style name="Theme.MyChord.TubeAwak" parent="Theme.Material3.Dark.NoActionBar">
        <item name="mcStroke">@android:color/transparent</item>
        <item name="mcBg">@color/t_tubeawak_mcbg</item>
        <item name="mcSurface">@color/t_tubeawak_mcsurface</item>
        <item name="mcSurface2">@color/t_tubeawak_mcsurface2</item>
        <item name="mcText">@color/t_tubeawak_mctext</item>
        <item name="mcTextDim">@color/t_tubeawak_mctextdim</item>
        <item name="mcAccent">@color/t_tubeawak_mcaccent</item>
        <item name="mcOnAccent">@color/t_tubeawak_mconaccent</item>
        <item name="colorPrimary">@color/t_tubeawak_colorprimary</item>
        <item name="colorOnPrimary">@color/t_tubeawak_coloronprimary</item>
        <item name="colorSecondary">@color/t_tubeawak_colorsecondary</item>
        <item name="colorPrimaryContainer">@color/t_tubeawak_colorprimarycontainer</item>
        <item name="colorOnPrimaryContainer">@color/t_tubeawak_coloronprimarycontainer</item>
        <item name="colorSecondaryContainer">@color/t_tubeawak_colorsecondarycontainer</item>
        <item name="colorOnSecondaryContainer">@color/t_tubeawak_coloronsecondarycontainer</item>
        <item name="colorSurface">@color/t_tubeawak_colorsurface</item>
        <item name="colorSurfaceContainer">@color/t_tubeawak_colorsurfacecontainer</item>
        <item name="colorSurfaceContainerHigh">@color/t_tubeawak_colorsurfacecontainerhigh</item>
        <item name="colorOnSurface">@color/t_tubeawak_coloronsurface</item>
        <item name="colorOnSurfaceVariant">@color/t_tubeawak_coloronsurfacevariant</item>
        <item name="colorOutline">@color/t_tubeawak_coloroutline</item>
        <item name="android:colorBackground">@color/t_tubeawak_colorbackground</item>
        <item name="android:windowBackground">@color/t_tubeawak_windowbackground</item>
        <item name="android:textColorPrimary">@color/t_tubeawak_textcolorprimary</item>
        <item name="android:textColorSecondary">@color/t_tubeawak_textcolorsecondary</item>
        <item name="android:statusBarColor">@color/t_tubeawak_statusbarcolor</item>
        <item name="android:navigationBarColor">@color/t_tubeawak_navigationbarcolor</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

