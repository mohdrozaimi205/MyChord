    <!-- ═══ Player — translucent overlay for PlayerActivity ═══ -->
    <style name="Theme.MyChord.Player" parent="Theme.MyChord.TubeAwak">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- ═══ Shape overlays for ShapeableImageView ═══ -->
    <style name="Shape.Round12" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">12dp</item></style>
    <style name="Shape.Round18" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">18dp</item></style>
    <style name="Shape.Round28" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">28dp</item></style>
    <style name="Shape.Circle" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>

    <!-- ═══ Reusable text styles ═══ -->
    <style name="Txt.Overline" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/mcAccent</item>
    </style>

    <style name="Txt.Huge" parent="">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/mcText</item>
    </style>

    <style name="Txt.Section" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/mcText</item>
    </style>

    <style name="Txt.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/mcText</item>
    </style>

    <style name="Txt.Dim" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/mcTextDim</item>
    </style>
</resources>
